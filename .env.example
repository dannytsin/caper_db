# Copy to .env and fill in. .env is gitignored.

# beehiiv API key — create at app.beehiiv.com → Settings → API (v2). NOT the MCP token.
BEEHIIV_API_KEY=

# Publication to archive (Caper).
BEEHIIV_PUBLICATION_ID=pub_07fb6d34-3930-4590-843f-37e955482ad7

# Postgres connection string, e.g. postgresql://user:pass@host:5432/caper
DATABASE_URL=

# Polite scraping: seconds between API calls (beehiiv rate-limits per plan).
BEEHIIV_MIN_INTERVAL=0.5

# --- chat.py only ---
# Anthropic API key for the chat agent.
ANTHROPIC_API_KEY=
# READ-ONLY connection string for the chat agent (see roles.sql). NOT the owner URL.
DATABASE_URL_RO=postgresql://caper_readonly:CHANGE_ME@host:5432/caper

# --- Google Analytics 4 (sync.py --ga) ---
# Numeric GA4 property id (Admin → Property Settings), NOT the G-XXXX measurement id.
GA_PROPERTY_ID=
# Service-account JSON, pasted as a single line. The service account needs Viewer
# on the property. (Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a file path.)
GA_SERVICE_ACCOUNT_JSON=
